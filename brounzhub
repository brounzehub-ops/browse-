-- Função para a rotação com aceleração e desaceleração
local function rotateImage()
    local startTime = tick()
    while imageLabel.Parent do
        local elapsedTime = tick() - startTime
        local remainingTime = duration - elapsedTime

        -- Se estiver no início, acelera
        if elapsedTime < (duration - decelerationTime) then
            if rotationSpeed < maxSpeed then
                rotationSpeed = rotationSpeed + acceleration
            end
        else -- Se estiver no final, desacelera
            if rotationSpeed > 0 then
                rotationSpeed = rotationSpeed - acceleration
            end
        end

        imageLabel.Rotation = imageLabel.Rotation + rotationSpeed
        task.wait(0.0001) -- Pequeno atraso para suavizar a rotação
    end
end

-- Função para aumentar o tamanho gradualmente
local function growImage()
    local startTime = tick()
    while tick() - startTime < growTime do
        local progress = (tick() - startTime) / growTime
        imageLabel.Size = UDim2.new(progress, 0, progress, 0)
        task.wait(0.01)
    end
    imageLabel.Size = UDim2.new(1, 0, 1, 0) -- Garante que fique no tamanho final
end

